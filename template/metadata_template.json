{
  "domain": "[DOMAIN_NAME]",

  "data_source": {
    "source_type": "[SENSOR/API/DATABASE]",
    "provider": "[OPTIONAL_PROVIDER_NAME]",
    "sampling_interval": "[e.g. 10 minutes]",
    "data_format": "[CSV/JSON/etc]"
  },

  "location": {
    "latitude": "[OPTIONAL]",
    "longitude": "[OPTIONAL]"
  },

  "columns": [
    {
      "name": "[COLUMN_NAME]",
      "type": "[float/integer/datetime/string]",
      "unit": "[UNIT_OR_NULL]",
      "range": "[MIN_MAX_OR_NULL]",
      "description": "[COLUMN_DESCRIPTION]"
    }
  ],

  "data_quality": {
    "missing_values": "[none/partial/etc]",
    "sensor_accuracy": "[OPTIONAL]"
  },

  "device_specs": {
    "edge_device": "[DEVICE_NAME]",
    "cpu": "[CPU_DESCRIPTION]",
    "memory": "[MEMORY_DESCRIPTION]"
  },

  "resource_constraints": {
    "low_cpu": "[true/false]",
    "low_memory": "[true/false]",
    "lightweight_execution_required": "[true/false]"
  },

  "storage": {
    "type": "[SQLite/CSV/etc]",
    "sync_policy": "[local/cloud/periodic]"
  }
}