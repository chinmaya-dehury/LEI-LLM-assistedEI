{
  "domain": "temp_humidity",

  "data_source": {
    "source_type": "SENSOR",
    "provider": "IoT Environmental Sensor",
    "sampling_interval": "5 minutes",
    "data_format": "CSV"
  },

  "location": {
    "latitude": "null",
    "longitude": "null"
  },

  "columns": [
    {
      "name": "timestamp",
      "type": "datetime",
      "unit": "ISO8601",
      "range": "null",
      "description": "Time at which the reading was recorded (local time)"
    },
    {
      "name": "temperature_c",
      "type": "float",
      "unit": "degree Celsius",
      "range": "15-40",
      "description": "Ambient temperature in degrees Celsius"
    },
    {
      "name": "humidity_percent",
      "type": "float",
      "unit": "percent",
      "range": "20-100",
      "description": "Relative humidity of air in percentage"
    }
  ],

  "data_quality": {
    "missing_values": "none",
    "sensor_accuracy": "+/-0.2°C, +/-2% RH"
  },

  "device_specs": {
    "edge_device": "Raspberry Pi 4",
    "cpu": "Quad-core 1.5GHz",
    "memory": "4GB RAM"
  },

  "resource_constraints": {
    "low_cpu": "false",
    "low_memory": "false",
    "lightweight_execution_required": "false"
  },

  "storage": {
    "type": "Local SQLite DB",
    "sync_policy": "periodic upload to cloud"
  }
}