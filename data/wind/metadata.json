{
  "domain": "wind",

  "data_source": {
    "source_type": "SENSOR",
    "provider": "Weather Station Network",
    "sampling_interval": "1 hour",
    "data_format": "CSV"
  },

  "location": {
    "latitude": "null",
    "longitude": "null"
  },

  "columns": [
    {
      "name": "date",
      "type": "datetime",
      "unit": "UTC",
      "range": "null",
      "description": "Time of wind measurement in UTC timezone"
    },
    {
      "name": "wind_speed_10m",
      "type": "float",
      "unit": "m/s",
      "range": "0-30",
      "description": "Wind speed measured at 10m height"
    },
    {
      "name": "wind_speed_80m",
      "type": "float",
      "unit": "m/s",
      "range": "0-40",
      "description": "Wind speed measured at 80m height"
    },
    {
      "name": "wind_direction_10m",
      "type": "float",
      "unit": "degrees",
      "range": "0-360",
      "description": "Wind direction at 10m height (0=North, 90=East)"
    },
    {
      "name": "wind_gusts_10m",
      "type": "float",
      "unit": "m/s",
      "range": "0-50",
      "description": "Maximum wind gust speed at 10m height"
    }
  ],

  "data_quality": {
    "missing_values": "none",
    "sensor_accuracy": "+/-0.1 m/s, +/-2 degrees"
  },

  "device_specs": {
    "edge_device": "Raspberry Pi 4 or equivalent",
    "cpu": "Quad-core ARM processor",
    "memory": "1-4 GB RAM"
  },

  "resource_constraints": {
    "low_cpu": "true",
    "low_memory": "true",
    "lightweight_execution_required": "true"
  },

  "storage": {
    "type": "CSV logs",
    "sync_policy": "periodic sync to cloud"
  }
}
