{
  "domain": "air_quality",

  "data_source": {
    "source_type": "SENSOR",
    "provider": "Air Quality Index Network",
    "sampling_interval": "10-15 minutes",
    "data_format": "CSV"
  },

  "location": {
    "latitude": "null",
    "longitude": "null"
  },

  "columns": [
    {
      "name": "timestamp",
      "type": "datetime",
      "unit": "ISO8601",
      "range": "null",
      "description": "Time of sensor reading in local timezone"
    },
    {
      "name": "pm2_5",
      "type": "float",
      "unit": "µg/m³",
      "range": "0-500",
      "description": "Fine particulate matter (2.5 micrometers or smaller)"
    },
    {
      "name": "pm10",
      "type": "float",
      "unit": "µg/m³",
      "range": "0-500",
      "description": "Coarse particulate matter (10 micrometers or smaller)"
    },
    {
      "name": "o3",
      "type": "float",
      "unit": "ppb",
      "range": "0-150",
      "description": "Ozone ground-level concentration"
    },
    {
      "name": "no2",
      "type": "float",
      "unit": "ppb",
      "range": "0-200",
      "description": "Nitrogen dioxide concentration"
    },
    {
      "name": "co",
      "type": "float",
      "unit": "ppm",
      "range": "0-10",
      "description": "Carbon monoxide concentration"
    }
  ],

  "data_quality": {
    "missing_values": "partial",
    "sensor_accuracy": "+/-5-10% for pollutants"
  },

  "device_specs": {
    "edge_device": "Raspberry Pi 4 / ARM Cortex-A53",
    "cpu": "1.5 GHz quad-core",
    "memory": "512 MB to 2 GB RAM"
  },

  "resource_constraints": {
    "low_cpu": "true",
    "low_memory": "true",
    "lightweight_execution_required": "true"
  },

  "storage": {
    "type": "CSV with local SQLite cache",
    "sync_policy": "periodic cloud sync"
  }
}